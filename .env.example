# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=https://www.yunle.fun

# API Configuration
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# GitHub OAuth Configuration
# 线上使用线上 OAuth App clientId，本地开发在 .env.local 中覆盖
# clientSecret 在 CloudBase 控制台配置，无需在此填写
NUXT_PUBLIC_GITHUB_CLIENT_ID=

# CloudBase Configuration
NUXT_PUBLIC_CLOUDBASE_ENV_ID=
NUXT_PUBLIC_CLOUDBASE_REGION=ap-shanghai
NUXT_PUBLIC_CLOUDBASE_ACCESS_KEY=

# account-api 的 CloudBase HTTP 访问服务地址（公开主页 /u SSR 代理 getProfile 用，仅服务端读取）
# HTTP 访问已绑定（2026-06，path /account-api，匿名）；推荐填：https://api.yunle.fun/account-api
# 备选默认域名：https://yunlefun-8g7ybcxc7345c490.service.tcloudbase.com/account-api
# 留空则 /u 退化为客户端渲染（功能正常，仅无 SSR SEO）。生效前提：account-api 已 tcb deploy 新代码
NUXT_ACCOUNT_API_HTTP_URL=

# SSO Configuration
# 生产只允许逐个登记的精确 HTTPS origin；禁止通配符，避免子域接管扩大 SSO 信任边界。
NUXT_PUBLIC_SSO_ALLOWED_TARGET_ORIGINS=https://drive.yunle.fun,https://cms.yunle.fun,https://apps.yunle.fun,https://wenta.yunle.fun,https://gmm.yunyoujun.cn,https://zero-echo.advjs.org,https://preview.advjs.org
# 本地 SSO 联调：dev 默认启用；生产环境如需让线上主站回传到本机 loopback，需显式设为 true
NUXT_PUBLIC_SSO_ALLOW_LOCAL_TARGET_ORIGINS=
# 仅协调升级期间短时打开：允许 0.3.x redirect Consumer 获取一次性 ticket；完成升级立即关闭。
NUXT_PUBLIC_SSO_ALLOW_LEGACY_REDIRECT=false
# sso-ticket 云函数服务端防线；签发/兑换与 returnUrl 分别校验（只允许 HTTPS）。
SSO_ALLOWED_ORIGINS=https://drive.yunle.fun,https://cms.yunle.fun,https://apps.yunle.fun,https://wenta.yunle.fun,https://gmm.yunyoujun.cn,https://zero-echo.advjs.org,https://preview.advjs.org
SSO_ALLOWED_RETURN_ORIGINS=https://drive.yunle.fun,https://cms.yunle.fun,https://apps.yunle.fun,https://wenta.yunle.fun,https://gmm.yunyoujun.cn,https://zero-echo.advjs.org,https://preview.advjs.org
# v1 -> v2 发布窗口的兼容回退；新部署留空，消费者收敛后删除。
SSO_ALLOWED_TARGET_ORIGINS=
SSO_ALLOW_LOCAL_TARGET_ORIGINS=false
# 仅在 SSO v1 -> v2 无中断发布窗口临时设为 true；消费者迁移完成后立即恢复 false。
SSO_ALLOW_LEGACY_DIRECT_TICKET=false
# 持久化限流阈值（固定 60 秒窗口；缺省值与下列值一致）。
SSO_ISSUE_PER_USER_PER_MINUTE=10
SSO_ISSUE_PER_IP_PER_MINUTE=30
SSO_EXCHANGE_PER_IP_PER_MINUTE=60
SSO_EXCHANGE_PER_ORIGIN_PER_MINUTE=300

# Payment Configuration
# 是否启用微信 H5 支付（移动端非微信浏览器），需要在商户平台申请开通后设为 true
NUXT_PUBLIC_ENABLE_H5_PAY=false

# Cloud Function Internal Service Token
# account-api 的内部扣费接口 deductCoinForUser 使用；需与调用方云函数配置一致
ACCOUNT_API_INTERNAL_TOKEN=

# 测试身份平台的 Cloud Functions 私有变量（全部使用独立随机值）
# ai-gateway ↔ account-api synthetic 结算
AI_GATEWAY_ACCOUNT_API_TOKEN=
# admin cleanup ↔ account-api 钱包基线恢复
TEST_BROKER_ACCOUNT_API_TOKEN=
# admin Broker ↔ sso-ticket 测试签票
TEST_BROKER_INTERNAL_TOKEN=
TEST_TICKET_ESCROW_KEY=
# admin Broker ↔ ai-gateway 租约能力与预算对账
TEST_LEASE_CAPABILITY_SIGNING_KEY=
TEST_BROKER_RECONCILE_TOKEN=
# test-identity-sweeper ↔ admin 定时清理
TEST_BROKER_SWEEP_KEY=

# 《零点回声》EdgeOne → ai-gateway 应用级 HMAC 签名密钥；两端必须配置同一个随机值
# 仅存在于 CloudBase / EdgeOne 服务端环境变量，绝不能使用 NUXT_PUBLIC_ 前缀
ZERO_ECHO_APP_SIGNING_SECRET=

# 双层会话迁移（见 docs/cookie-session-migration.md）
# nuxt-auth-utils 封 sealed httpOnly cookie 的密钥，至少 32 字符；生产部署前必须在 EdgeOne env 配置，否则 build 失败
NUXT_SESSION_PASSWORD=
# 双层会话总开关；启用后再开内存化（token 不落 localStorage）
NUXT_PUBLIC_COOKIE_SESSION=
NUXT_PUBLIC_COOKIE_SESSION_MEMORY=

# App Store Server API Configuration
# 本地部署 iap-order / appstore-notify 云函数时使用；私钥文件不要提交到仓库。
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY_FILE=
APPSTORE_BUNDLE_ID=fun.yunle.apps
APPSTORE_APP_APPLE_ID=
