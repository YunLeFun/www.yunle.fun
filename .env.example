# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=https://www.yunle.fun

# API Configuration
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# GitHub OAuth Configuration
# 线上使用线上 OAuth App clientId，本地开发在 .env.local 中覆盖
# clientSecret 在 CloudBase 控制台配置，无需在此填写
NUXT_PUBLIC_GITHUB_CLIENT_ID=

# CloudBase Configuration
NUXT_PUBLIC_CLOUDBASE_ENV_ID=
NUXT_PUBLIC_CLOUDBASE_REGION=ap-shanghai
NUXT_PUBLIC_CLOUDBASE_ACCESS_KEY=

# account-api 的 CloudBase HTTP 访问服务地址（公开主页 /u SSR 代理 getProfile 用，仅服务端读取）
# 留空默认使用生产只读入口 https://api.yunle.fun/account-api；本地/预发环境应覆盖为对应环境入口。
# 备选默认域名：https://yunlefun-8g7ybcxc7345c490.service.tcloudbase.com/account-api
# 生效前提：account-api 已部署并绑定匿名 HTTP 访问路径。
NUXT_ACCOUNT_API_HTTP_URL=

# apps.yunle.fun 的服务端目录 API（公开主页应用 + 登录用户私人工坊，仅服务端读取）
# 留空默认使用 https://apps.yunle.fun；本地联调可覆盖为应用站的本地 Nitro 地址。
NUXT_APPS_PLATFORM_API_URL=

# SSO v3 configuration. Development uses an isolated issuer and CloudBase tenant.
AUTH_ISSUER_ENVIRONMENT=production
# CloudBase 自定义登录私钥；private key 可用 PEM（换行写成 \n）或 base64。
SSO_TICKET_PRIVATE_KEY_ID=
SSO_TICKET_PRIVATE_KEY=
SSO_TICKET_REFRESH_SEC=2592000
# Client Registry 使用独立 Ed25519 密钥；不得复用身份断言或桌面 entitlement 密钥。
SSO_REGISTRY_SIGNING_KEY=
SSO_REGISTRY_SIGNING_KID=
# Registry 控制面与 CI 使用独立的至少 32-byte 随机值；两者不得复用。
SSO_REGISTRY_APPROVAL_PEPPER=
SSO_REGISTRY_CI_TOKEN=
# production 审批者只按不可变 CloudBase uid 授权；JSON 数组，不填写邮箱。
SSO_REGISTRY_APPROVER_UIDS=[]
SES_TEMPLATE_REGISTRY_APPROVAL=
# 仅安装到 YunLeFun/www.yunle.fun 的发布 GitHub App；私钥支持 PEM 或 base64。
SSO_REGISTRY_GITHUB_APP_ID=
SSO_REGISTRY_GITHUB_APP_INSTALLATION_ID=
SSO_REGISTRY_GITHUB_APP_PRIVATE_KEY=
# 同一 GitHub App 注入 registry-release Environment，用于生成分支、PR 与受检合并。
REGISTRY_RELEASE_APP_ID=
REGISTRY_RELEASE_APP_PRIVATE_KEY=
# sso-ticket 身份断言 Ed25519 密钥；私钥支持 PEM/JWK 或其 base64，严禁提交真实值。
SSO_IDENTITY_SIGNING_KEY=
SSO_IDENTITY_SIGNING_KID=
# 轮换时临时保留旧公钥：{ "<old-kid>": <public-jwk> }
SSO_IDENTITY_PUBLIC_KEYS={}
SSO_IDENTITY_ASSERTION_TTL_SEC=120
# 持久化限流阈值（固定 60 秒窗口；缺省值与下列值一致）。
SSO_ISSUE_PER_USER_PER_MINUTE=10
SSO_ISSUE_PER_IP_PER_MINUTE=30
SSO_EXCHANGE_PER_IP_PER_MINUTE=60
SSO_EXCHANGE_PER_ORIGIN_PER_MINUTE=300

# Payment Configuration
# 是否启用微信 H5 支付（移动端非微信浏览器），需要在商户平台申请开通后设为 true
NUXT_PUBLIC_ENABLE_H5_PAY=false

# Cloud Function Internal Service Token
# account-api 的内部扣费接口 deductCoinForUser 使用；需与调用方云函数配置一致
ACCOUNT_API_INTERNAL_TOKEN=
# YunLeFun AI Runtime 调用 account-api AI 点数私有 action 的专用 token；
# 不得复用通用 account-api、云币、Admin 或测试身份 token。
YUNLEFUN_AI_RUNTIME_ACCOUNT_API_TOKEN=
# YunLeFun AI Runtime 调用 account-api 云币预留私有 action 的专用 token；
# 与 AI 点数 token 独立轮换，不能跨用途复用。
YUNLEFUN_AI_COIN_ACCOUNT_API_TOKEN=
# Drive BFF 与用户存储、回收站定时器分别使用的独立 Web Resume 服务令牌。
WEB_RESUME_STORAGE_INTERNAL_TOKEN=
WEB_RESUME_SWEEPER_INTERNAL_TOKEN=
# Play 弹珠机正式云币回合专用 token；不得复用通用内部或奖励 token。
PLAY_PACHINKO_ACCOUNT_API_TOKEN=
# 奖励控制面专用 token ring；最多 current/previous 两枚 32-byte base64 token。
# current 与 admin 一致，不得复用上方内部 token。
REWARD_CONTROL_TOKENS=
# 奖励领取链接摘要与速率凭证必须使用两个不同的至少 32-byte 随机值。
REWARD_CLAIM_LINK_HASH_KEY=
REWARD_CLAIM_RATE_TICKET_SECRET=
# reward-claim-ops 私有定时函数的告警 Webhook。
REWARD_CLAIM_OPS_WEBHOOK_URL=

# 账号生命周期事务邮件（Cloudflare Email Sending；仅服务端）
ACCOUNT_LIFECYCLE_EMAIL_MODE=dry_run
ACCOUNT_LIFECYCLE_DAILY_USER_LIMIT=45
ACCOUNT_LIFECYCLE_DAILY_OPS_LIMIT=5
SES_REGION=ap-guangzhou
SES_FROM_EMAIL=account@notify.yunle.fun
SES_FROM_NAME=云乐坊账号安全
SES_REPLY_TO=kf@yunle.fun
SES_OPS_EMAIL=security@yunle.fun
# SES 模板验收入口；默认关闭，密钥需为独立的至少 32 字节随机值
SES_ACCEPTANCE_ENABLED=false
SES_ACCEPTANCE_EMAIL=
SES_ACCEPTANCE_SIGNING_KEY=
SES_TEMPLATE_DELETION_REQUESTED=
SES_TEMPLATE_DELETION_REMINDER_7D=
SES_TEMPLATE_DELETION_REMINDER_1D=
SES_TEMPLATE_DELETION_COMPLETED=
SES_TEMPLATE_DELETION_DELAYED=
SES_TEMPLATE_DELETION_CLEANUP_OPS=

# 测试身份平台的 Cloud Functions 私有变量（全部使用独立随机值）
# 固定测试账号的部署环境边界；account-api / wxpay-order 必须显式配置 test 或 production。
YUNLEFUN_TEST_ACCOUNT_ENVIRONMENT=
# admin cleanup ↔ account-api 钱包基线恢复
TEST_BROKER_ACCOUNT_API_TOKEN=
# admin Broker ↔ sso-ticket 测试签票
TEST_BROKER_INTERNAL_TOKEN=
# admin 原生测试 SSO ↔ sso-ticket 标准 PKCE 签码（必须与 Broker token 不同）
TEST_TICKET_ESCROW_KEY=
# test-identity-sweeper ↔ admin 定时清理
TEST_BROKER_SWEEP_KEY=

# 双层会话迁移（见 docs/cookie-session-migration.md）
# nuxt-auth-utils 封 sealed httpOnly cookie 的密钥，至少 32 字符；生产部署前必须在 EdgeOne env 配置，否则 build 失败
NUXT_SESSION_PASSWORD=
# 双层会话总开关；启用后再开内存化（token 不落 localStorage）
NUXT_PUBLIC_COOKIE_SESSION=
NUXT_PUBLIC_COOKIE_SESSION_MEMORY=

# App Store Server API Configuration
# APPSTORE_KEY_ID / APPSTORE_PRIVATE_KEY_FILE 必须来自
# App Store Connect → 用户与访问 → 集成 → App 内购买，不可使用普通团队 API Key。
# 本地部署 iap-order / appstore-notify 云函数时使用；私钥文件不要提交到仓库。
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY_FILE=
APPSTORE_BUNDLE_ID=fun.yunle.apps
APPSTORE_APP_APPLE_ID=
