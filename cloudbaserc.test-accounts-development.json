{
  "version": "2.0",
  "envId": "yunlefun-dev-0ge03bdod37093d1",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "account-api",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": "auth != null"
      },
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "TEST_BROKER_ACCOUNT_API_TOKEN": "{{env.TEST_BROKER_ACCOUNT_API_TOKEN}}",
        "YUNLEFUN_TEST_ACCOUNT_ENVIRONMENT": "test"
      }
    },
    {
      "name": "ai-gateway",
      "timeout": 90,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": "auth != null"
      },
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "YUNLEFUN_TEST_ACCOUNT_ENVIRONMENT": "test"
      }
    },
    {
      "name": "wxpay-order",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": "auth != null"
      },
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "YUNLEFUN_TEST_ACCOUNT_ENVIRONMENT": "test"
      }
    }
  ]
}
