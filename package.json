{
  "name": "www-yunle-fun",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build && node scripts/verify-edgeone-client-shells.mjs",
    "build:authorization-core": "pnpm --dir packages/authorization-core build",
    "deploy:sso:development": "node scripts/deploy-sso-development.mjs",
    "dev": "TMPDIR=/tmp nuxt dev --host",
    "dev:sso": "node scripts/dev-sso-provider.mjs",
    "dev:sso:trust": "caddy trust --address 127.0.0.1:2031",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/setup-hooks.mjs",
    "pretest": "pnpm build:authorization-core",
    "pretest:watch": "pnpm build:authorization-core",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:wxpay-lib": "node scripts/sync-wxpay-lib.mjs",
    "sso:registry": "node scripts/sso-registry.mjs",
    "ci": "npm i -g corepack && pnpm install"
  },
  "dependencies": {
    "@cloudbase/auth": "catalog:",
    "@cloudbase/js-sdk": "catalog:",
    "@cloudbase/signature-nodejs": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@lucide/vue": "catalog:",
    "@nuxt/ui": "catalog:",
    "@nuxtjs/mdc": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "@yunlefun/authorization-core": "workspace:*",
    "@yunlefun/sso": "catalog:",
    "@yunlefun/types": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "nuxt": "catalog:",
    "nuxt-auth-utils": "catalog:",
    "qrcode": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "vue-input-otp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@apple/app-store-server-library": "catalog:",
    "@iconify-json/ri": "catalog:",
    "@nuxt/eslint": "catalog:",
    "@nuxt/icon": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxtjs/i18n": "catalog:",
    "@oxc-minify/binding-linux-x64-gnu": "catalog:",
    "@oxc-parser/binding-linux-x64-gnu": "catalog:",
    "@oxc-transform/binding-linux-x64-gnu": "catalog:",
    "@rollup/plugin-yaml": "catalog:",
    "@types/qrcode": "catalog:",
    "@vue/test-utils": "catalog:",
    "@yunlefun/cloudbase-registry-shadow": "workspace:*",
    "baseline-browser-mapping": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "happy-dom": "catalog:",
    "oxc-parser": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
