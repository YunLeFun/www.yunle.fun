    "@nuxt/ui": "catalog:",
    "@nuxtjs/mdc": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "@yunlefun/sso": "catalog:",
    "@yunlefun/types": "catalog:",
    "nuxt": "catalog:",
    "nuxt-auth-utils": "catalog:",
    "qrcode": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@apple/app-store-server-library": "catalog:",
    "@iconify-json/ri": "catalog:",
    "@nuxt/eslint": "catalog:",
    "@nuxt/icon": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxtjs/i18n": "catalog:",
    "@rollup/plugin-yaml": "catalog:",
    "@types/qrcode": "catalog:",
    "@vue/test-utils": "catalog:",
    "baseline-browser-mapping": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
