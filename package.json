{
  "name": "www-yunle-fun",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "dev": "TMPDIR=/tmp nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/setup-hooks.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:wxpay-lib": "node scripts/sync-wxpay-lib.mjs",
    "ci": "npm i -g corepack && pnpm install"
  },
  "dependencies": {
    "@cloudbase/auth": "catalog:",
    "@cloudbase/js-sdk": "catalog:",
    "@cloudbase/signature-nodejs": "catalog:",
