{
  "version": "2.0",
  "envId": "yunlefun-8g7ybcxc7345c490",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "cloudrun": {
    "name": "www-yunle-fun"
  },
  "functionRoot": "./functions",
  "functions": [
    {
      "name": "wxpay-order",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "WX_MCH_ID": "",
        "WX_SERIAL_NO": "",
        "WX_PRIVATE_KEY": "",
        "WX_APIV3_KEY": "",
        "WX_APPID": "",
        "WX_NOTIFY_URL": ""
      }
    },
    {
      "name": "wxpay-notify",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "WX_APIV3_KEY": "",
        "WX_APPID": "",
        "WX_MCH_ID": "",
        "WX_PLATFORM_CERTIFICATES": "",
        "WX_TIME_TOLERANCE": "300"
      }
    },
    {
      "name": "account-api",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {}
    }
  ],
  "ai": {
    "defaultAgent": "{{env.AI_DEFAULT_AGENT}}",
    "agents": {
      "codebuddy": {
        "type": "none"
      }
    }
  }
}
