{
  "version": "2.0",
  "envId": "yunlefun-8g7ybcxc7345c490",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "cloudrun": {
    "name": "api"
  },
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "wxpay-order",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "WX_MCH_ID": "",
        "WX_SERIAL_NO": "",
        "WX_PRIVATE_KEY": "",
        "WX_APIV3_KEY": "",
        "WX_APPID": "",
        "WX_NOTIFY_URL": ""
      }
    },
    {
      "name": "wxpay-notify",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "WX_APIV3_KEY": "",
        "WX_APPID": "",
        "WX_MCH_ID": "",
        "WX_PLATFORM_CERTIFICATES": "",
        "WX_TIME_TOLERANCE": "300"
      }
    },
    {
      "name": "account-api",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}"
      }
    },
    {
      "name": "user-storage-api",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "ai-gateway",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}"
      }
    },
    {
      "name": "desktop-auth",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "DESKTOP_AUTH_SIGNING_KEY": "{{env.DESKTOP_AUTH_SIGNING_KEY}}",
        "DESKTOP_AUTH_SIGNING_KID": "{{env.DESKTOP_AUTH_SIGNING_KID}}",
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "DESKTOP_AUTH_VERIFICATION_URL": "https://www.yunle.fun/link"
      }
    },
    {
      "name": "sso-ticket",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "SSO_TICKET_PRIVATE_KEY_ID": "{{env.SSO_TICKET_PRIVATE_KEY_ID}}",
        "SSO_TICKET_PRIVATE_KEY": "{{env.SSO_TICKET_PRIVATE_KEY}}",
        "SSO_TICKET_REFRESH_SEC": "{{env.SSO_TICKET_REFRESH_SEC}}"
      }
    },
    {
      "name": "iap-order",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "APPSTORE_ISSUER_ID": "",
        "APPSTORE_KEY_ID": "",
        "APPSTORE_PRIVATE_KEY": "",
        "APPSTORE_BUNDLE_ID": "fun.yunle.apps",
        "APPSTORE_APP_APPLE_ID": ""
      }
    },
    {
      "name": "appstore-notify",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "APPSTORE_ISSUER_ID": "",
        "APPSTORE_KEY_ID": "",
        "APPSTORE_PRIVATE_KEY": "",
        "APPSTORE_BUNDLE_ID": "fun.yunle.apps",
        "APPSTORE_APP_APPLE_ID": ""
      }
    },
    {
      "name": "shortlink-resolve",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "shortlink-stat",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "github-api",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "GITHUB_APP_ID": "{{env.GITHUB_APP_ID}}",
        "GITHUB_APP_SLUG": "{{env.GITHUB_APP_SLUG}}",
        "GITHUB_APP_PRIVATE_KEY": "{{env.GITHUB_APP_PRIVATE_KEY}}",
        "GITHUB_APP_CLIENT_ID": "{{env.GITHUB_APP_CLIENT_ID}}",
        "GITHUB_APP_CLIENT_SECRET": "{{env.GITHUB_APP_CLIENT_SECRET}}",
        "GITHUB_APP_STATE_SECRET": "{{env.GITHUB_APP_STATE_SECRET}}"
      }
    }
  ],
  "ai": {
    "defaultAgent": "{{env.AI_DEFAULT_AGENT}}",
    "agents": {
      "codebuddy": {
        "type": "none"
      }
    }
  }
}
