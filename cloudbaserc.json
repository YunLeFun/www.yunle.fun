{
  "version": "2.0",
  "envId": "yunlefun-8g7ybcxc7345c490",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "cloudrun": {
    "name": "api"
  },
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "wxpay-order",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "WX_MCH_ID": "",
        "WX_SERIAL_NO": "",
        "WX_PRIVATE_KEY": "",
        "WX_APIV3_KEY": "",
        "WX_APPID": "",
        "WX_NOTIFY_URL": ""
      }
    },
    {
      "name": "wxpay-notify",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "WX_APIV3_KEY": "",
        "WX_APPID": "",
        "WX_MCH_ID": "",
        "WX_PLATFORM_CERTIFICATES": "",
        "WX_TIME_TOLERANCE": "300"
      }
    },
    {
      "name": "account-api",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": "auth != null"
      },
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "AI_GATEWAY_ACCOUNT_API_TOKEN": "{{env.AI_GATEWAY_ACCOUNT_API_TOKEN}}",
        "TEST_BROKER_ACCOUNT_API_TOKEN": "{{env.TEST_BROKER_ACCOUNT_API_TOKEN}}",
        "REWARD_CONTROL_TOKENS": "{{env.REWARD_CONTROL_TOKENS}}",
        "REWARD_CLAIM_LINK_HASH_KEY": "{{env.REWARD_CLAIM_LINK_HASH_KEY}}",
        "REWARD_CLAIM_RATE_TICKET_SECRET": "{{env.REWARD_CLAIM_RATE_TICKET_SECRET}}",
        "REWARD_CLAIM_SITE_URL": "https://www.yunle.fun",
        "REWARD_CLAIM_MEMBERSHIP_HIGH_THRESHOLD_DAYS": "3650"
      }
    },
    {
      "name": "account-deletion-sweeper",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": false
      },
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}"
      },
      "triggers": [
        {
          "name": "accountDeletionSweepHourly",
          "type": "timer",
          "config": "0 30 * * * * *"
        }
      ]
    },
    {
      "name": "reward-claim-ops",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": false
      },
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "REWARD_CLAIM_OPS_WEBHOOK_URL": "{{env.REWARD_CLAIM_OPS_WEBHOOK_URL}}",
        "REWARD_CLAIM_ADMIN_URL": "https://admin.yunle.fun/reward-claims"
      },
      "triggers": [
        {
          "name": "rewardClaimOpsEveryMinute",
          "type": "timer",
          "config": "0 * * * * * *"
        }
      ]
    },
    {
      "name": "account-lifecycle-notifier",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": false
      },
      "envVariables": {
        "ACCOUNT_LIFECYCLE_EMAIL_MODE": "dry_run",
        "ACCOUNT_LIFECYCLE_DAILY_USER_LIMIT": "45",
        "ACCOUNT_LIFECYCLE_DAILY_OPS_LIMIT": "5",
        "SES_REGION": "ap-guangzhou",
        "SES_FROM_EMAIL": "account@notify.yunle.fun",
        "SES_FROM_NAME": "云乐坊账号安全",
        "SES_REPLY_TO": "kf@yunle.fun",
        "SES_OPS_EMAIL": "security@yunle.fun",
        "SES_TEMPLATE_DELETION_REQUESTED": "{{env.SES_TEMPLATE_DELETION_REQUESTED}}",
        "SES_TEMPLATE_DELETION_REMINDER_7D": "{{env.SES_TEMPLATE_DELETION_REMINDER_7D}}",
        "SES_TEMPLATE_DELETION_REMINDER_1D": "{{env.SES_TEMPLATE_DELETION_REMINDER_1D}}",
        "SES_TEMPLATE_DELETION_COMPLETED": "{{env.SES_TEMPLATE_DELETION_COMPLETED}}",
        "SES_TEMPLATE_DELETION_DELAYED": "{{env.SES_TEMPLATE_DELETION_DELAYED}}",
        "SES_TEMPLATE_DELETION_CLEANUP_OPS": "{{env.SES_TEMPLATE_DELETION_CLEANUP_OPS}}"
      },
      "triggers": [
        {
          "name": "accountLifecycleNotifyEveryFiveMinutes",
          "type": "timer",
          "config": "0 */5 * * * * *"
        }
      ]
    },
    {
      "name": "user-storage-api",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}"
      }
    },
    {
      "name": "ai-gateway",
      "timeout": 90,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": "auth != null"
      },
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "AI_GATEWAY_ACCOUNT_API_TOKEN": "{{env.AI_GATEWAY_ACCOUNT_API_TOKEN}}",
        "TEST_LEASE_CAPABILITY_SIGNING_KEY": "{{env.TEST_LEASE_CAPABILITY_SIGNING_KEY}}",
        "TEST_BROKER_RECONCILE_TOKEN": "{{env.TEST_BROKER_RECONCILE_TOKEN}}"
      }
    },
    {
      "name": "desktop-auth",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "DESKTOP_AUTH_SIGNING_KEY": "{{env.DESKTOP_AUTH_SIGNING_KEY}}",
        "DESKTOP_AUTH_SIGNING_KID": "{{env.DESKTOP_AUTH_SIGNING_KID}}",
        "DESKTOP_AUTH_PUBLIC_KEYS": "{{env.DESKTOP_AUTH_PUBLIC_KEYS}}",
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "AUTH_ISSUER_ENVIRONMENT": "{{env.AUTH_ISSUER_ENVIRONMENT}}",
        "DESKTOP_AUTH_CANONICAL_URL": "https://api.yunle.fun/desktop-auth",
        "DESKTOP_AUTH_VERIFICATION_URL": "https://www.yunle.fun/link"
      }
    },
    {
      "name": "sso-ticket",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": "auth != null"
      },
      "envVariables": {
        "SSO_TICKET_PRIVATE_KEY_ID": "{{env.SSO_TICKET_PRIVATE_KEY_ID}}",
        "SSO_TICKET_PRIVATE_KEY": "{{env.SSO_TICKET_PRIVATE_KEY}}",
        "SSO_TICKET_REFRESH_SEC": "{{env.SSO_TICKET_REFRESH_SEC}}",
        "AUTH_ISSUER_ENVIRONMENT": "{{env.AUTH_ISSUER_ENVIRONMENT}}",
        "SSO_ISSUE_PER_USER_PER_MINUTE": "{{env.SSO_ISSUE_PER_USER_PER_MINUTE}}",
        "SSO_ISSUE_PER_IP_PER_MINUTE": "{{env.SSO_ISSUE_PER_IP_PER_MINUTE}}",
        "SSO_EXCHANGE_PER_IP_PER_MINUTE": "{{env.SSO_EXCHANGE_PER_IP_PER_MINUTE}}",
        "SSO_EXCHANGE_PER_ORIGIN_PER_MINUTE": "{{env.SSO_EXCHANGE_PER_ORIGIN_PER_MINUTE}}",
        "TEST_BROKER_INTERNAL_TOKEN": "{{env.TEST_BROKER_INTERNAL_TOKEN}}",
        "TEST_TICKET_ESCROW_KEY": "{{env.TEST_TICKET_ESCROW_KEY}}",
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}"
      }
    },
    {
      "name": "test-identity-sweeper",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false,
      "aclRule": {
        "invoke": false
      },
      "envVariables": {
        "TEST_BROKER_SWEEP_KEY": "{{env.TEST_BROKER_SWEEP_KEY}}"
      },
      "triggers": [
        {
          "name": "testIdentitySweepEveryMinute",
          "type": "timer",
          "config": "0 * * * * * *"
        }
      ]
    },
    {
      "name": "sso-security-sweeper",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": false
      },
      "triggers": [
        {
          "name": "ssoSecuritySweepHourly",
          "type": "timer",
          "config": "0 0 * * * * *"
        }
      ]
    },
    {
      "name": "session-security-sweeper",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": false
      },
      "triggers": [
        {
          "name": "sessionSecuritySweepHourly",
          "type": "timer",
          "config": "0 15 * * * * *"
        }
      ]
    },
    {
      "name": "iap-order",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "APPSTORE_ISSUER_ID": "",
        "APPSTORE_KEY_ID": "",
        "APPSTORE_PRIVATE_KEY": "",
        "APPSTORE_BUNDLE_ID": "fun.yunle.apps",
        "APPSTORE_APP_APPLE_ID": ""
      }
    },
    {
      "name": "appstore-notify",
      "timeout": 30,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "APPSTORE_ISSUER_ID": "",
        "APPSTORE_KEY_ID": "",
        "APPSTORE_PRIVATE_KEY": "",
        "APPSTORE_BUNDLE_ID": "fun.yunle.apps",
        "APPSTORE_APP_APPLE_ID": ""
      }
    },
    {
      "name": "shortlink-resolve",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "shortlink-stat",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true
    },
    {
      "name": "github-api",
      "timeout": 10,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "ACCOUNT_API_INTERNAL_TOKEN": "{{env.ACCOUNT_API_INTERNAL_TOKEN}}",
        "GITHUB_APP_ID": "{{env.GITHUB_APP_ID}}",
        "GITHUB_APP_SLUG": "{{env.GITHUB_APP_SLUG}}",
        "GITHUB_APP_PRIVATE_KEY": "{{env.GITHUB_APP_PRIVATE_KEY}}",
        "GITHUB_APP_CLIENT_ID": "{{env.GITHUB_APP_CLIENT_ID}}",
        "GITHUB_APP_CLIENT_SECRET": "{{env.GITHUB_APP_CLIENT_SECRET}}",
        "GITHUB_APP_STATE_SECRET": "{{env.GITHUB_APP_STATE_SECRET}}"
      }
    }
  ],
  "ai": {
    "defaultAgent": "{{env.AI_DEFAULT_AGENT}}",
    "agents": {
      "codebuddy": {
        "type": "none"
      }
    }
  }
}
