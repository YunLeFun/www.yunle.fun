# Production composition is fail-closed. Use the canonical CloudBase EnvId, never an alias.
ADVJS_AI_CLOUDBASE_ENV_ID=yunlefun-example-123456
ADVJS_AI_ALLOWED_ORIGINS=https://studio.advjs.org

# Inject these as separate CloudBase Run secrets. Never commit real values.
ADVJS_AI_ADMIN_TOKEN=replace-me
ADVJS_AI_ACCOUNT_API_TOKEN=replace-me

# Optional lifecycle tuning; defaults shown below.
ADVJS_AI_ACTIVE_TASK_TTL_MS=900000
ADVJS_AI_LEASE_DURATION_MS=120000
ADVJS_AI_STALE_TASK_AFTER_MS=300000
ADVJS_AI_WORKER_POLL_MS=500
ADVJS_AI_WORKER_BATCH_SIZE=10
ADVJS_AI_SWEEP_INTERVAL_MS=60000
