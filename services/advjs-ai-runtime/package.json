{
  "name": "@yunlefun/advjs-ai-runtime",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "cloudbase-functions.json",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "policy:manifest": "node ../../scripts/bootstrap-ai-runtime-policy.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "dev": "pnpm build && ADVJS_AI_RUNTIME_MODE=local-fake tcb-ff",
    "start": "tcb-ff"
  },
  "dependencies": {
    "@advjs/parser": "catalog:",
    "@cloudbase/node-sdk": "catalog:"
  },
  "devDependencies": {
    "@cloudbase/functions-framework": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
